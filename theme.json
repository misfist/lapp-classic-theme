{
    "settings": {
        "appearanceTools": true,
        "background": {
            "backgroundImage": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "color": {
            "link": true,
            "custom": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "name": "White",
                    "slug": "base",
                    "color": "#ffffff"
                },
                {
                    "name": "Light Gray",
                    "slug": "base-2",
                    "color": "#F0F0F0"
                },
                {
                    "name": "Gray",
                    "slug": "base-4",
                    "color": "#cccccc"
                },
                {
                    "name": "Dark Gray",
                    "slug": "base-5",
                    "color": "#949494"
                },
                {
                    "name": "Black",
                    "slug": "contrast",
                    "color": "#231F20"
                },
                {
                    "name": "Teal",
                    "slug": "accent",
                    "color": "#00A99D"
                },
                {
                    "name": "Magenta",
                    "slug": "accent-2",
                    "color": "#e8266b"
                },
                {
                    "name": "Amber",
                    "slug": "accent-3",
                    "color": "#F5B335"
                },
                {
                    "name": "Lime",
                    "slug": "accent-4",
                    "color": "#8DC63F"
                },
                {
                    "name": "Orange",
                    "slug": "accent-5",
                    "color": "#F47920"
                },
                {
                    "name": "Red",
                    "slug": "accent-6",
                    "color": "#BE3D2A"
                }
            ]
        },
        "custom": {
            "className": "lapp",
            "primary": "var( --wp--preset--color--accent-2 )",
            "primary-variation": "var( --wp--preset--color--contrast )",
            "secondary": "var( --wp--preset--color--accent )",
            "secondary-variation": "var( --wp--preset--color--base-2 )",
            "dark-gray": "var( --wp--preset--color--contrast )",
            "medium-gray": "var( --wp--preset--color--base-4 )",
            "light-gray": "var( --wp--preset--color--base-2 )",
            "newspack-primary-color": "#231F20",
            "newspack-secondary-color": "#F0F0F0",
            "newspack-cta-color": "#e8266b",
            "newspack-header-color": "#231F20",
            "newspack-primary-menu-color": "#231F20",
            "newspack-footer-color": "#231F20",
            "newspack-primary-contrast-color": "white",
            "newspack-secondary-contrast-color": "black",
            "newspack-cta-contrast-color": "white",
            "newspack-header-contrast-color": "white",
            "newspack-primary-menu-contrast-color": "white",
            "newspack-footer-contrast-color": "white",
            "newspack-theme-font-body": "var( --wp--preset--font-family--sans )",
            "newspack-theme-font-heading": "var( --wp--preset--font-family--serif )"
        },
        "layout": {
            "contentSize": "780px",
            "wideSize": "1200px"
        },
        "spacing": {
            "customSpacingSize": false,
            "blockGap": true
        },
        "typography": {
            "dropCap": true,
            "customFontSize": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "Lora",
                    "slug": "serif",
                    "fontFamily": "\"Lora\", \"Georgia\", \"serif\""
                },
                {
                    "name": "Works Sans",
                    "slug": "sans",
                    "fontFamily": "\"Works Sans\", \"Helvetica\", \"sans-serif\""
                },
                {
                    "name": "Staatliches",
                    "slug": "display",
                    "fontFamily": "\"Staatliches\", sans-serif"
                }
            ]
        }
    },
    "styles": {
        "blocks": {
            "core/button": {
                "color": {
                    "background": "var( --wp--preset--color--accent-2 )",
                    "text": "var( --wp--preset--color--base )"
                },
                "border": {
                    "radius": "5px"
                },
                "typography": {
                    "fontStyle": "normal",
                    "fontWeight": "700",
                    "textTransform": "uppercase",
                    "fontFamily": "var( --wp--preset--font-family--sans )"
                }
            },
            "core/list": {
                "variations": {
                    "no-bullets": {
                        "css": "&.is-style-no-bullets{list-style:none;padding-left:0;margin-left:0;} &.is-style-no-bullets li:not(:last-child) {margin-bottom:var( --wp--preset--spacing--20 );}"
                    }
                }
            },
            "core/pullquote": {
                "color": {
                    "text": "var( --wp--preset--color--contrast-2 )"
                }
            }
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var( --wp--preset--color--accent-2 )",
                    "text": "var( --wp--preset--color--base )"
                },
                "typography": {
                    "fontFamily": "var( --wp--preset--font-family--sans )",
                    "textTransform": "uppercase"
                }
            },
            "caption": {
                "color": {
                    "text": "var( --wp--preset--color--base-5 )"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var( --wp--preset--font-family--serif )"
                }
            },
            "link": {
                "color": {
                    "text": "var( --wp--preset--color--contrast )"
                }
            }
        },
        "color": {
            "background": "var( --wp--preset--color--base )",
            "text": "var( --wp--preset--color--contrast )"
        },
        "typography": {
            "fontFamily": "var( --wp--preset--font-family--sans )",
            "fontSize": "var( --wp--preset--font-size--medium )",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "var( --wp--preset--spacing--40 )"
        }
    },
    "version": 3,
    "$schema": "https://schemas.wp.org/wp/6.8/theme.json"
}