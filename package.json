{
	"name": "lapp-classic-theme",
	"dependencies": {
		"@wordpress/scripts": "^19.2.4"
	},
	"devDependencies": {
		"sass": "^1.83.4",
		"sass-loader": "^16.0.4"
	},
	"scripts": {
		"start": "wp-scripts start --webpack-src-dir=src",
		"build": "wp-scripts build --webpack-src-dir=src",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"dist": "zip -r lapp-classic-theme.zip . -x '*.git*' -x 'node_modules/*' -x 'src/*' -x 'package*.json' -x 'webpack.config.js' -x '.stylelintrc.json' -x '.distignore' -x '.gitignore'"
	}
}
